# Copiare in .env e adattare. In produzione: /etc/tavolo/tavolo.env (permessi 600).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Livello dei log: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tavolo
DB_PASSWORD=tavolo_dev
DB_NAME=tavolo

# Database usato da Vitest e Playwright: i test ne CANCELLANO i dati.
# Il nome deve finire con _test. Password con # o spazi: tra apici singoli.
# In alternativa: docker compose --profile db-test up -d e DB_TEST_PORT=3307.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_USER=dandzapp_test
DB_TEST_PASSWORD=
DB_TEST_NAME=dandzapp_test

# Limite ai tentativi su accesso, registrazione e recupero password (lasciare true).
LIMITE_TENTATIVI=true

# Indirizzo pubblico dell'applicazione: link nelle email e controllo dell'Origin.
# In sviluppo è il server di Vite.
APP_URL=http://localhost:5173

# Email (inviti, recupero password) come DSN; vuoto = le email vengono solo scritte nel log.
#   smtp://utente:password@host:porta   (STARTTLS se il server lo offre)
#   smtps://utente:password@host:465    (TLS diretto)
# Caratteri speciali in utente/password vanno codificati (es. @ → %40).
# Esempi: Mailpit locale (docker compose up -d) → smtp://127.0.0.1:1025
#         Mailtrap (sandbox)                     → smtp://UTENTE:PASSWORD@sandbox.smtp.mailtrap.io:2525
# Prova: npm run email:prova -- tuo@indirizzo.it
MAILER_DSN=
EMAIL_MITTENTE=Tavolo virtuale <tavolo@localhost>

# Cartella dei file del server (immagini delle avventure importate). Vuoto = dati/ alla radice.
# In produzione: fuori dalla DocumentRoot, inclusa nel backup.
DATA_DIR=

# Cartella della build della SPA servita da Fastify (vuoto = apps/web/build)
WEB_BUILD_DIR=
