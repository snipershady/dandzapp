# Copiare in .env e adattare. In produzione: /etc/tavolo/tavolo.env (permessi 600).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Livello dei log: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tavolo
DB_PASSWORD=tavolo_dev
DB_NAME=tavolo
# Database usato da Vitest e Playwright: deve essere DIVERSO da DB_NAME, i test ne cancellano i dati.
DB_NAME_TEST=tavolo_test

# Cartella della build della SPA servita da Fastify (vuoto = apps/web/build)
WEB_BUILD_DIR=
