{
  "name": "dandzapp",
  "private": true,
  "description": "Tavolo virtuale per D&D BECMI",
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dandzapp/server & npm run dev --workspace @dandzapp/web; wait",
    "dev:server": "npm run dev --workspace @dandzapp/server",
    "dev:web": "npm run dev --workspace @dandzapp/web",
    "build": "npm run build --workspace @dandzapp/web",
    "start": "npm run start --workspace @dandzapp/server",
    "db:migra": "npm run db:migra --workspace @dandzapp/server",
    "db:annulla": "npm run db:annulla --workspace @dandzapp/server",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @dandzapp/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run check --workspaces --if-present",
    "verifica": "npm run lint && npm run check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
