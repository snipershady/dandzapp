# Parametri del Tavolo virtuale in produzione o in staging.
# Copia in /etc/tavolo/tavolo.env (proprietario root, gruppo tavolo, permessi 640) e adatta.
# Formato .env: CHIAVE=valore, una per riga. Le righe con # sono commenti.
# Dopo ogni modifica: sudo systemctl restart tavolo
#
# Il file lo legge il servizio (systemd passa ENV_FILE) e lo leggono i comandi lanciati
# con deploy/comando.sh: c'è un solo posto dove cambiare i parametri.

NODE_ENV=production
# Node ascolta solo in locale: dall'esterno si passa da Apache2/nginx.
HOST=127.0.0.1
PORT=3010
LOG_LEVEL=info

# Indirizzo pubblico: link nelle email, controllo dell'Origin, cookie Secure se https.
APP_URL=https://dandzapp.spinfo.it

# MySQL 9.7 locale, con un utente che ha i privilegi solo su questo schema.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tavolo
DB_PASSWORD=CAMBIAMI
DB_NAME=tavolo

# Immagini delle avventure importate: fuori dalla cartella pubblica, scrivibile dal servizio.
DATA_DIR=/var/lib/tavolo

# Email (inviti, recupero password) come DSN; vuoto = le email finiscono solo nel log.
#   smtp://utente:password@host:porta   (STARTTLS se il server lo offre)
#   smtps://utente:password@host:465    (TLS diretto)
# Caratteri speciali in utente o password vanno codificati (es. @ → %40, : → %3A).
# Per cambiare servizio di posta basta cambiare questa riga e riavviare.
# Prova: sudo deploy/comando.sh email:prova -- tuo@indirizzo.it
MAILER_DSN=
EMAIL_MITTENTE="Tavolo virtuale <noreply@spinfo.it>"
