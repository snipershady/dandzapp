# Installazione: sudo cp deploy/systemd/tavolo-backup.* /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now tavolo-backup.timer
[Unit]
Description=Backup notturno del Tavolo virtuale

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
